# care-api 環境變數範本。複製成 .env 後填入真值；.env 不進 git、由 docker-compose 以唯讀掛進容器。
# 測試與正式環境「只差這個檔」：同一份程式碼、同一個 image。
#
#   測試環境：SUPABASE_URL=https://api-staging.haiglobals.com、綠界測試端點（payment-stage / einvoice-stage）、APNS_ENV=sandbox
#   正式環境：SUPABASE_URL=https://api.haiglobals.com、綠界正式端點（payment / einvoice）、APNS_ENV=production
#
# ⚠ ENVIRONMENT 必須與 SUPABASE_URL 對得上（staging ↔ api-staging、production ↔ api），避免測試程式碼打到正式庫。

# ---- 伺服器 ----
HOST=127.0.0.1
PORT=9100
ENVIRONMENT=staging
# 對外可達的 functions 網址（綠界 ReturnURL、App 端 CARE_FUNCTIONS_BASE_URL 都以此為準）
FUNCTIONS_PUBLIC_URL=https://carematching.haiglobals.com/functions/v1
SITE_URL=https://staging.haiglobals.com

# ---- Supabase（care 資料在 schema pro_care_matching；由 _shared_care/db.ts 以 CARE_DB_SCHEMA 決定，預設 pro_care_matching）----
SUPABASE_URL=https://api-staging.haiglobals.com
SUPABASE_PUBLIC_URL=https://api-staging.haiglobals.com
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 直連資料庫（部分維運腳本使用）；容器內請用可達的主機位址
SUPABASE_DB_URL=

# ---- 推播 ----
# Firebase service account JSON（整段 JSON 字串，或檔案路徑，依 _shared_care 實作）
FCM_SERVICE_ACCOUNT=
# pg_cron / DB 觸發器呼叫 send-notification 用的最小權限金鑰；必須與 DB 表 care_push_config.cron_key 一致
CRON_PUSH_SECRET=
# APNs（iOS 來電／通知）
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=com.carematch.proCareMatcing
APNS_ENV=sandbox
# 掛進容器的 .p8 私鑰路徑（docker-compose 把 ./secrets 掛到 /app/secrets）
CARE_APNS_KEY_FILE=/app/secrets/AuthKey_XXXXXXXXXX.p8

# ---- 綠界 ECPay（測試環境值請用綠界測試商店；正式環境換成正式商店與正式端點）----
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
ECPAY_CHOOSE_PAYMENT=Credit
ECPAY_CHECKOUT_URL=https://payment-stage.ecpay.com.tw/Cashier/AioCheckOut/V5
ECPAY_CREDIT_ACTION_URL=https://payment-stage.ecpay.com.tw/CreditDetail/DoAction
ECPAY_CREDIT_PERIOD_ACTION_URL=https://payment-stage.ecpay.com.tw/Cashier/CreditCardPeriodAction
# 電子發票
ECPAY_INVOICE_MERCHANT_ID=
ECPAY_INVOICE_HASH_KEY=
ECPAY_INVOICE_HASH_IV=
ECPAY_INVOICE_PLATFORM_ID=
ECPAY_INVOICE_ISSUE_URL=https://einvoice-stage.ecpay.com.tw/B2CInvoice/Issue
ECPAY_INVOICE_INVALID_URL=https://einvoice-stage.ecpay.com.tw/B2CInvoice/Invalid
# 物流（haiglobals 共用模組需要，care 目前未使用；留空即可）
ECPAY_LOGISTICS_C2C_MERCHANT_ID=
ECPAY_LOGISTICS_C2C_HASH_KEY=
ECPAY_LOGISTICS_C2C_HASH_IV=
ECPAY_LOGISTICS_MAP_URL=https://logistics-stage.ecpay.com.tw/Express/map
ECPAY_LOGISTICS_CREATE_URL=https://logistics-stage.ecpay.com.tw/Express/Create
